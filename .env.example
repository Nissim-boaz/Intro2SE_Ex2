# העתק לקובץ .env ומלא ערכים
SECRET_KEY=change-me-to-a-long-random-string

# 1 = התחברות מדומה עם בורר תפקיד, בלי אימות (לפיתוח). 0 = Google בלבד
MOCK_AUTH=1

# Client ID מ-Google Cloud Console (OAuth 2.0, Web application)
GOOGLE_CLIENT_ID=

# מייל של מנהל המערכת הראשי. נוצר אוטומטית, ושינוי שלו מעביר את המנהל הקיים לכתובת החדשה
ADMIN_EMAIL=admin@example.com

# הכתובת הקבועה מבחוץ (Tailscale Funnel), למשל https://my-pc.tailnet-name.ts.net
PUBLIC_URL=

# סיכום הקלטות (Gemini, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# גיבוי כשהמודל הראשי עמוס (מופרדים בפסיק)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# תמלול מקומי
WHISPER_MODEL=small
