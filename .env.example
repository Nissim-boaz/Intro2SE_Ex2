# העתק לקובץ .env ומלא ערכים
SECRET_KEY=change-me-to-a-long-random-string

# 1 = התחברות מדומה עם בורר תפקיד (לפיתוח ולדמו). 0 = Google בלבד
MOCK_AUTH=1

# Client ID מ-Google Cloud Console (OAuth 2.0, Web application)
GOOGLE_CLIENT_ID=

# מייל של האדמין הראשון. נוצר אוטומטית בהרצה הראשונה
ADMIN_EMAIL=admin@example.com

# סיכום הקלטות (Gemini, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# גיבוי כשהמודל הראשי עמוס (מופרדים בפסיק)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# תמלול מקומי
WHISPER_MODEL=small
