# Environment Configuration
SECRET_KEY=dev-secret-key-change-in-production-123456789
HMAC_SECRET=dev-hmac-secret-for-qr-tokens-987654321
LECTURER_PASSWORD=admin123

# Google OAuth Credentials (for real deployment)
# If left blank or MOCK_AUTH=1, local simulated Google login is enabled for frictionless testing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOCK_AUTH=1

# Campus Network Settings
CAMPUS_IP_FILE=data/campus_ips.txt
CAMPUS_IP_RANGES=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16

# Data paths
CLASS_CSV_PATH=data/students.csv
DATABASE_PATH=data/attendance.db

# QR & Cookie timing
QR_WINDOW_SECONDS=6
COOKIE_MAX_AGE_SECONDS=300
DEFAULT_SESSION_DURATION_MINUTES=90
